generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  FARMER
  TRANSPORTER
  WAREHOUSE_ADMIN
  RETAILER
}

enum ProduceCategory {
  DAIRY
  FRUITS
  VEGETABLES
  MEAT
  SEAFOOD
  FLOWERS
}

enum ProduceBatchStatus {
  DRAFT
  HARVESTED
  IN_TRANSIT
  COLD_STORAGE
  DELIVERED
  COMPROMISED
}

enum ShipmentStatus {
  DRAFT
  HARVESTED
  IN_TRANSIT
  COLD_STORAGE
  DELIVERED
  COMPROMISED
}

enum StorageMode {
  AMBIENT
  REFRIGERATED
  FROZEN
}

enum DestinationType {
  WAREHOUSE
  RETAIL_OUTLET
  DIRECT_CONSUMER
}

model Organization {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganizationMembership[]
  farms          Farm[]
  warehouses     Warehouse[]
  produceBatches ProduceBatch[]
  shipments      Shipment[]

  @@index([name])
}

model User {
  id                   String                   @id @default(cuid())
  name                 String
  email                String                   @unique
  passwordHash         String
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          OrganizationMembership[]
  createdBatches       ProduceBatch[]           @relation("ProduceBatchCreatedBy")
  transportedShipments Shipment[]               @relation("ShipmentTransporter")
  retailShipments      Shipment[]               @relation("ShipmentRetailer")

  @@index([name])
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([role])
}

model Farm {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  address         String
  city            String
  region          String
  latitude        Float
  longitude       Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  produceBatches  ProduceBatch[]
  originShipments Shipment[]

  @@index([organizationId])
  @@index([city, region])
}

model Warehouse {
  id                   String       @id @default(cuid())
  organizationId       String
  name                 String
  address              String
  city                 String
  region               String
  latitude             Float
  longitude            Float
  coldStorageEnabled   Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinationShipments Shipment[]

  @@index([organizationId])
  @@index([city, region])
  @@index([coldStorageEnabled])
}

model ProduceBatch {
  id                 String             @id @default(cuid())
  organizationId     String
  farmId             String
  createdByUserId    String
  batchCode          String
  produceType        String
  variety            String?
  category           ProduceCategory
  quantity           Float
  unit               String             @default("kg")
  grade              String?
  harvestDate        DateTime?
  status             ProduceBatchStatus @default(DRAFT)
  optimalTempMin     Float
  optimalTempMax     Float
  optimalHumidityMin Float
  optimalHumidityMax Float
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm               Farm               @relation(fields: [farmId], references: [id], onDelete: Restrict)
  createdBy          User               @relation("ProduceBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  shipment           Shipment?

  @@unique([organizationId, batchCode])
  @@index([organizationId])
  @@index([farmId])
  @@index([createdAt])
  @@index([status])
  @@index([batchCode])
}

model Shipment {
  id                           String          @id @default(cuid())
  organizationId               String
  produceBatchId               String          @unique
  originFarmId                 String
  destinationWarehouseId       String?
  transporterUserId            String?
  retailerUserId               String?
  trackingCode                 String
  status                       ShipmentStatus  @default(DRAFT)
  destinationType              DestinationType
  storageMode                  StorageMode
  requiresTransport            Boolean         @default(false)
  tamperSealEnabled            Boolean         @default(false)
  sealId                       String?
  containers                   Json?
  photos                       Json?
  notes                        String?
  originNameSnapshot           String
  originAddressSnapshot        String
  originLatitudeSnapshot       Float
  originLongitudeSnapshot      Float
  destinationNameSnapshot      String
  destinationAddressSnapshot   String
  destinationLatitudeSnapshot  Float
  destinationLongitudeSnapshot Float
  currentLatitude              Float?
  currentLongitude             Float?
  temperatureAlert             Boolean         @default(false)
  humidityAlert                Boolean         @default(false)
  tamperAlert                  Boolean         @default(false)
  idempotencyKey               String?
  scheduledAt                  DateTime?
  departedAt                   DateTime?
  deliveredAt                  DateTime?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  organization                 Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  produceBatch                 ProduceBatch    @relation(fields: [produceBatchId], references: [id], onDelete: Restrict)
  originFarm                   Farm            @relation(fields: [originFarmId], references: [id], onDelete: Restrict)
  destinationWarehouse         Warehouse?      @relation(fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  transporterUser              User?           @relation("ShipmentTransporter", fields: [transporterUserId], references: [id], onDelete: SetNull)
  retailerUser                 User?           @relation("ShipmentRetailer", fields: [retailerUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, trackingCode])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([originFarmId])
  @@index([destinationWarehouseId])
  @@index([transporterUserId])
  @@index([retailerUserId])
  @@index([status])
  @@index([createdAt])
  @@index([trackingCode])
}
